Crop_ET     = mean(Crop_ET,     na.rm = TRUE),
WDrainage   = mean(WDrainage,   na.rm = TRUE),
WRunoff     = mean(WRunoff,     na.rm = TRUE),
sWUE        = mean(sWUE,        na.rm = TRUE),
