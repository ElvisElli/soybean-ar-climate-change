dat <- subset(dat, auth == 'Dos Santos')


for (mg.tgt in unique(dat$mg2)){
  mdat <- subset(dat, mg2 == mg.tgt)
  mdat$date <- as.Date(mdat$date, '%m/%d/%Y')
  mdat$year <- as.numeric(strftime(mdat$date, '%Y'))
  mdat$id<- paste(mdat$site, mdat$year, mdat$pd, sep = '-')
  cultivar.name <- paste0('Elli_', mg.tgt)
  
  
  
  run_mg <- function(mdat){
    mg.res <- vector('list', length(unique(mdat$id)))
    names(mg.res) <- unique(mdat$id)
    
    for (i in unique(mdat$id)){
      idat <- subset(mdat, id == i )
      
      site.name <- idat$site[1]
      soil <- readRDS(paste0('./simulations/soil/', site.name, '.rds'))
      soil <- soil[[1]]
      soil$initialwater <- initialwater_parms(
        Thickness = soil$soil$Thickness,
        InitialValues = soil$soil$DUL)
      
      met <- paste0('./weather/', site.name, '.met')
      
      ## here we will update the apsim file to represent
      ## our simulation
      
      pp1 <- '.Simulations.Simulation.Field.Sowing'
      sim.pd <- strftime(unique(as.Date(idat$pd, '%m/%d/%Y')), '%b-%d')
      
      edit_apsimx(file = 'base-simulation.apsimx',
                  src.dir = './simulations/',
                  wrt.dir = './simulations/',
                  parm.path = pp1,
                  node = 'Other',
                  parm = 'CultivarName',
                  verbose = FALSE,
                  value = cultivar.name,
                  overwrite = TRUE)
      
      edit_apsimx(file = 'base-simulation.apsimx',
                  src.dir = './simulations/',
                  wrt.dir = './simulations/',
                  parm.path = pp1,
                  node = 'Other',
                  parm = 'SowDate',
                  verbose = FALSE,
                  value = sim.pd,
                  overwrite = TRUE)
      
      edit_apsimx(file = 'base-simulation.apsimx',
                  src.dir = './simulations/',
                  wrt.dir = './simulations/',
                  node = 'Weather',
                  value = met,
                  verbose = FALSE,
                  overwrite = TRUE)
      
      edit_apsimx_replace_soil_profile(file = 'base-simulation.apsimx',
                                       src.dir = './simulations/',
                                       wrt.dir = './simulations/',
                                       verbose = FALSE,
                                       soil.profile = soil,
                                       overwrite = TRUE)
      
      sim0 <- apsimx(file = 'base-simulation.apsimx',
                     src.dir = './simulations/',
                     cleanup = TRUE)
      
      sim0$id <- i
      row.names(sim0) <- NULL
      mg.res[[i]] <- sim0
    }
    
    mg.res <- do.call('rbind', mg.res)
    return(mg.res)
    
  }
  
  
  objfun <- function(parms,
                     starting.values){
    
    phen.pamrs <- parms * starting.values
    
    phenp1 <- paste0('.Simulations.Replacements.Soybean.Elli.', cultivar.name,'.Vegetative')
    phenp2 <- paste0('.Simulations.Replacements.Soybean.Elli.', cultivar.name,'.EarlyFlowering')
    phenp3 <- paste0('.Simulations.Replacements.Soybean.Elli.', cultivar.name,'.EarlyGrainFilling')
    phenp4 <- paste0('.Simulations.Replacements.Soybean.Elli.', cultivar.name,'.LateGrainFilling')
    phenp5 <- paste0('.Simulations.Replacements.Soybean.Elli.', cultivar.name,'.ReproductivePhotoperiodModifier')
    
    
    edit_apsimx_replacement(file = 'base-simulation.apsimx',
                            src.dir = './simulations/',
                            wrt.dir = './simulations/',
                            root = list("Models.Core.Folder", 1),
                            verbose = FALSE,
                            parm = phenp1, 
                            value = phen.pamrs[1],
                            overwrite = TRUE)
    
    edit_apsimx_replacement(file = 'base-simulation.apsimx',
                            src.dir = './simulations/',
                            wrt.dir = './simulations/',
                            root = list("Models.Core.Folder", 1),
                            verbose = FALSE,
                            parm = phenp2, 
                            value = phen.pamrs[2],
                            overwrite = TRUE)
    
    edit_apsimx_replacement(file = 'base-simulation.apsimx',
                            src.dir = './simulations/',
                            wrt.dir = './simulations/',
                            root = list("Models.Core.Folder", 1),
                            verbose = FALSE,
                            parm = phenp3, 
                            value = phen.pamrs[3],
                            overwrite = TRUE)
    
    edit_apsimx_replacement(file = 'base-simulation.apsimx',
                            src.dir = './simulations/',
                            wrt.dir = './simulations/',
                            root = list("Models.Core.Folder", 1),
                            verbose = FALSE,
                            parm = phenp4, 
                            value = phen.pamrs[4],
                            overwrite = TRUE)
    
    edit_apsimx_replacement(file = 'base-simulation.apsimx',
                            src.dir = './simulations/',
                            wrt.dir = './simulations/',
                            root = list("Models.Core.Folder", 1),
                            verbose = FALSE,
                            parm = phenp5, 
                            value = paste(phen.pamrs[5], phen.pamrs[6], sep = ', '),
                            overwrite = TRUE)
    
    
    mg.res <- run_mg(mdat)
  
    
    comb <- merge(mg.res,
          mdat,
          by.x = c('id', 'Date'),
          by.y = c('id', 'date'))
  
    plot(comb)  
    
    
  }
  
  
  
}



